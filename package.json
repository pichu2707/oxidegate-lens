{
  "name": "oxidegate-lens",
  "version": "0.7.1",
  "description": "Read-only presentation layer for OxideGate: shows how many bytes each MCP server costs on every request. Targets eager harnesses (OpenCode and similar), where those bytes are sent whether the proxy is there or not. It reads the proxy's HTTP endpoints; it never measures anything itself.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "bin": {
    "oxidegate-savings": "bin/oxidegate-savings.mjs",
    "oxidegate-mcp": "bin/oxidegate-mcp.mjs"
  },
  "files": [
    "bin",
    "lib",
    "opencode",
    "examples",
    "README.md"
  ],
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.2"
  },
  "exports": {
    ".": "./opencode/oxidegate-lens.ts",
    "./server": "./opencode/oxidegate-lens.ts",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pichu2707/oxidegate-lens.git"
  },
  "bugs": {
    "url": "https://github.com/pichu2707/oxidegate-lens/issues"
  },
  "homepage": "https://github.com/pichu2707/oxidegate-lens#readme",
  "keywords": [
    "mcp",
    "opencode",
    "oxidegate",
    "tokens",
    "context",
    "observability",
    "llm",
    "proxy"
  ],
  "main": "./opencode/oxidegate-lens.ts"
}
